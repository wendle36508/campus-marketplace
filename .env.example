# Copy this file to .env and fill in what you need.
# Everything is optional for a local demo: with no keys the app runs on
# SQLite, prints verification codes to the console (and shows them on screen),
# and uses sample AI price suggestions.

# ---- App -------------------------------------------------------------------
APP_NAME=[APP NAME]
PORT=3000
# Public URL of the app, used in magic sign-in links. On Render this is set automatically.
APP_URL=http://localhost:3000
# Set to "production" when deployed (secure cookies, hides dev codes).
NODE_ENV=development

# ---- Database --------------------------------------------------------------
# Leave empty to use a local SQLite file (data/marketplace.sqlite).
# For production use Postgres, e.g. Neon, Supabase or Railway:
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# ---- Email (verification codes) ------------------------------------------
# console = print codes in the terminal (demo) | resend | smtp
EMAIL_PROVIDER=console
EMAIL_FROM=Campus Marketplace <verify@yourdomain.com>

# Resend (https://resend.com): create an API key and verify your sending domain
RESEND_API_KEY=

# Or any SMTP server (Gmail app password, SendGrid, Postmark, Amazon SES...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Show the code on the verify screen. Defaults to true only when
# EMAIL_PROVIDER=console. Never turn this on in production.
# DEV_SHOW_CODES=false

# ---- AI price suggestions --------------------------------------------------
# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: which Claude model to use
AI_MODEL=claude-opus-5-5

# ---- Admin + demo data -------------------------------------------------------
# Your school email(s), comma separated, to get the admin dashboard
ADMIN_EMAILS=
# Fill an empty database with demo listings (set to false for a clean launch)
SEED_DEMO_DATA=true
